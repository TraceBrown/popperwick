#!/usr/bin/env python3
"""lane-glm-do — GLM 5.3 (z.ai coding plan) as a headless, tool-less text worker for the
lane account. VERSION 3 (2026-09-10): the interface Astra designed for itself
(.openai/2026-09-10-astra-lane-glm-design.md), on the direct-HTTPS transport.

  Instructions come from --prompt-file; source material comes on stdin; argv carries
  only switches and paths (never source text, never credentials — ps is world-readable).

    lane-glm-do --prompt-file extract.txt --effort high --max-tokens 8000 --deadline 300 \\
        --format jsonl --expect-ids chunk-01.ids --output chunk-01.draft.jsonl < chunk-01.txt

    printf 'Reply with exactly OK.\\n' | lane-glm-do --effort off --max-tokens 64 --deadline 15

Effort: off (thinking disabled — smoke tests and trivial transforms), low, high, max.
Output: stdout, or --output FILE written privately and renamed atomically only after
validation; a failed or truncated response is left as FILE.partial with a nonzero exit.
Validation: finish_reason must be "stop" (a "length" finish is a truncated draft, exit 75);
with --format jsonl and --expect-ids, every expected id must appear exactly once and no
other id may appear (exit 75 on any mismatch). Stderr carries elapsed time, finish reason,
usage and validation status — never reasoning text or response bodies.
Key: ~/.credentials/zai.key (dir 700, file 600, owned by the caller, not a symlink, one
line), read straight into the request header. Exit codes: 0 ok · 65 bad input · 69 key or
config · 70 request failed · 75 truncated or incomplete · 124 deadline.
"""
import sys, os, stat, json, time, argparse, select, threading, tempfile, ssl, socket
import urllib.request, urllib.error

ENDPOINT = "https://api.z.ai/api/coding/paas/v4/chat/completions"
MODEL = "glm-5.3"
MAX_STDIN = 25 * 1024
STDIN_FIRST_BYTE_WAIT = 2.0

def die(msg, code):
    sys.stderr.write("lane-glm-do: %s\n" % msg); sys.exit(code)

def read_key(path):
    try:
        st = os.lstat(path)
    except OSError as e:
        die("key file %s: %s" % (path, e.strerror), 69)
    if stat.S_ISLNK(st.st_mode) or not stat.S_ISREG(st.st_mode):
        die("key file must be a regular file, not a symlink", 69)
    if st.st_uid != os.getuid():
        die("key file must be owned by the calling user", 69)
    if stat.S_IMODE(st.st_mode) != 0o600:
        die("key file must be mode 600 (is %o)" % stat.S_IMODE(st.st_mode), 69)
    dst = os.lstat(os.path.dirname(os.path.abspath(path)))
    if stat.S_IMODE(dst.st_mode) & 0o077:
        die("key directory must not be group/world accessible (mode %o)" % stat.S_IMODE(dst.st_mode), 69)
    with open(path, "rb") as fh:
        data = fh.read(4096)
    lines = [l for l in data.decode("utf-8", "strict").splitlines() if l.strip()]
    if len(lines) != 1 or len(lines[0]) < 20 or any(c.isspace() for c in lines[0]):
        die("key file must hold exactly one key on one line", 69)
    return lines[0]

def read_stdin_material(deadline_at):
    """Material on stdin; a tty or an open-but-silent stdin yields nothing (no blocking)."""
    if sys.stdin.isatty():
        return ""
    fd = sys.stdin.fileno()
    r, _, _ = select.select([fd], [], [], STDIN_FIRST_BYTE_WAIT)
    if not r:
        return ""
    chunks, total = [], 0
    while True:
        remaining = deadline_at - time.monotonic()
        if remaining <= 0:
            die("deadline reached while reading stdin", 124)
        r, _, _ = select.select([fd], [], [], min(remaining, 5.0))
        if not r:
            continue
        chunk = os.read(fd, 65536)
        if not chunk:
            break
        total += len(chunk)
        if total > MAX_STDIN:
            die("stdin exceeds %d bytes; chunk the material (record boundaries, locators kept)" % MAX_STDIN, 65)
        chunks.append(chunk)
    try:
        return b"".join(chunks).decode("utf-8", "strict")
    except UnicodeDecodeError:
        die("stdin is not valid UTF-8", 65)

class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        raise urllib.error.HTTPError(req.full_url, code, "redirect refused (%s)" % newurl, headers, fp)

def call(key, body, deadline_at, connect_timeout):
    data = json.dumps(body).encode("utf-8")
    req = urllib.request.Request(ENDPOINT, data=data, method="POST",
                                 headers={"Content-Type": "application/json",
                                          "Authorization": "Bearer " + key,
                                          "Accept": "application/json"})
    ctx = ssl.create_default_context()
    opener = urllib.request.build_opener(NoRedirect(), urllib.request.HTTPSHandler(context=ctx))
    result = {}
    def worker():
        try:
            remaining = max(1.0, deadline_at - time.monotonic())
            socket.setdefaulttimeout(min(connect_timeout, remaining))
            with opener.open(req, timeout=remaining) as resp:
                result["status"] = resp.status
                result["body"] = resp.read(8 * 1024 * 1024)
        except urllib.error.HTTPError as e:
            result["status"] = e.code
            try:
                result["body"] = e.read(4096)
            except Exception:
                result["body"] = b""
        except Exception as e:
            result["error"] = "%s: %s" % (type(e).__name__, e)
    t = threading.Thread(target=worker, daemon=True); t.start()
    started = time.monotonic(); beat = 30.0
    while t.is_alive():
        t.join(timeout=1.0)
        el = time.monotonic() - started
        if el >= beat:
            sys.stderr.write("[lane-glm-do: waiting %ds]\n" % int(el)); beat += 30.0
        if time.monotonic() >= deadline_at and t.is_alive():
            die("deadline reached after %ds with no response" % int(el), 124)
    return result, time.monotonic() - started

def validate_jsonl(text, expect_ids):
    ids, bad = [], []
    for n, line in enumerate(text.splitlines(), 1):
        if not line.strip():
            continue
        try:
            obj = json.loads(line)
        except Exception:
            bad.append("line %d is not JSON" % n); continue
        if not isinstance(obj, dict) or "id" not in obj:
            bad.append("line %d has no id" % n); continue
        ids.append(str(obj["id"]))
    if bad:
        return "malformed jsonl: " + "; ".join(bad[:5])
    if expect_ids is not None:
        exp = set(expect_ids); got = set(ids)
        dup = sorted({i for i in ids if ids.count(i) > 1})
        missing = sorted(exp - got); extra = sorted(got - exp)
        if missing or extra or dup:
            return "id coverage failed: missing=%s extra=%s duplicate=%s" % (missing[:10], extra[:10], dup[:10])
    return None

def main():
    ap = argparse.ArgumentParser(add_help=True)
    ap.add_argument("--prompt-file", help="instructions (required unless --prompt is given for short, public text)")
    ap.add_argument("--prompt", help="short PUBLIC instruction text; appears in ps — never source material")
    ap.add_argument("--effort", choices=["off", "low", "high", "max"], default="off")
    ap.add_argument("--max-tokens", type=int, default=8000)
    ap.add_argument("--deadline", type=float, default=300.0, help="hard wall-clock seconds for the whole call")
    ap.add_argument("--connect-timeout", type=float, default=20.0)
    ap.add_argument("--format", choices=["text", "jsonl"], default="text")
    ap.add_argument("--expect-ids", help="file with one expected id per line (jsonl only)")
    ap.add_argument("--output", help="write here atomically; FILE.partial on failure")
    ap.add_argument("--key-file", default=os.environ.get("LANE_GLM_KEY_FILE", os.path.expanduser("~/.credentials/zai.key")))
    a = ap.parse_args()
    if not a.prompt_file and not a.prompt:
        die("give --prompt-file (or --prompt for a short public instruction)", 65)
    if a.expect_ids and a.format != "jsonl":
        die("--expect-ids needs --format jsonl", 65)
    deadline_at = time.monotonic() + a.deadline
    key = read_key(a.key_file)
    try:
        instructions = open(a.prompt_file, encoding="utf-8").read() if a.prompt_file else a.prompt
    except OSError as e:
        die("prompt file: %s" % e.strerror, 65)
    if not instructions.strip():
        die("empty instructions", 65)
    material = read_stdin_material(deadline_at)
    expect_ids = None
    if a.expect_ids:
        try:
            expect_ids = [l.strip() for l in open(a.expect_ids, encoding="utf-8") if l.strip()]
        except OSError as e:
            die("expect-ids file: %s" % e.strerror, 65)
        if not expect_ids:
            die("expect-ids file is empty", 65)
    content_text = instructions if not material else instructions.rstrip("\n") + "\n\n" + material
    if a.format == "jsonl":
        content_text += "\n\nOUTPUT FORMAT: one JSON object per line, each with an \"id\" field%s. No prose before or after." % (
            " matching exactly the %d expected ids" % len(expect_ids) if expect_ids else "")
    body = {"model": MODEL, "max_tokens": a.max_tokens,
            "messages": [{"role": "user", "content": content_text}]}
    if a.effort == "off":
        body["thinking"] = {"type": "disabled"}
    else:
        body["thinking"] = {"type": "enabled"}; body["reasoning_effort"] = a.effort
    res, elapsed = call(key, body, deadline_at, a.connect_timeout)
    del key
    if "error" in res:
        die("request failed after %.1fs: %s" % (elapsed, res["error"]), 70)
    if res.get("status") != 200:
        die("HTTP %s after %.1fs: %s" % (res.get("status"), elapsed, res.get("body", b"")[:300].decode("utf-8", "replace").replace("\n", " ")), 70)
    try:
        r = json.loads(res["body"].decode("utf-8"))
        ch = (r.get("choices") or [{}])[0]; msg = ch.get("message") or {}
        content = msg.get("content") or ""; fin = ch.get("finish_reason"); u = r.get("usage") or {}
    except Exception as e:
        die("unparseable response (%s)" % type(e).__name__, 70)
    status = "ok"; problem = None
    if fin != "stop":
        status = "truncated"; problem = "finish_reason=%s (not stop)" % fin
    elif not content.strip():
        status = "empty"; problem = "content empty with finish_reason=stop"
    elif a.format == "jsonl":
        v = validate_jsonl(content, expect_ids)
        if v:
            status = "incomplete"; problem = v
    sys.stderr.write("[lane-glm-do: model=%s effort=%s elapsed=%.1fs finish=%s in=%s out=%s status=%s]\n" % (
        r.get("model"), a.effort, elapsed, fin, u.get("prompt_tokens"), u.get("completion_tokens"), status))
    out_text = content if content.endswith("\n") else content + "\n"
    if a.output:
        target = a.output if status == "ok" else a.output + ".partial"
        d = os.path.dirname(os.path.abspath(target)) or "."
        fd, tmp = tempfile.mkstemp(prefix=".lane-glm-do.", dir=d)
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write(out_text)
        os.chmod(tmp, 0o600); os.replace(tmp, target)
        sys.stderr.write("[lane-glm-do: wrote %s]\n" % target)
    else:
        sys.stdout.write(out_text)
    if problem:
        die(problem, 75)

if __name__ == "__main__":
    main()
